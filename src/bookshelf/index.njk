---
title: Bookshelf
layout: base.njk
permalink: /bookshelf/
---
<section class="container">
<div class="prose bookshelf-page">
  <h1>Bookshelf</h1>

  <h2 class="bookshelf-section__title">Currently Reading</h2>
  <div class="current-read">
    <img
      class="current-read__cover"
      src="https://covers.openlibrary.org/b/isbn/9781933368368-L.jpg"
      alt="Cover of The Good Fairies of New York"
      loading="lazy"
      onerror="this.style.display='none'"
    />
    <div class="current-read__details">
      <p class="current-read__title">The Good Fairies of New York</p>
      <p class="current-read__author">by Martin Millar</p>
    </div>
  </div>

  <h2 class="bookshelf-section__title">Recommendations</h2>

  <div class="shelf-toggle" role="group" aria-label="Group recommendations">
    <button class="shelf-toggle__btn" id="toggle-genre" aria-pressed="true">By genre</button>
    <button class="shelf-toggle__btn" id="toggle-region" aria-pressed="false">By region</button>
  </div>

  {% set genreOrder = [
    "Literary fiction",
    "Crime fiction",
    "Magical realism",
    "Historical fiction",
    "Coming of age",
    "Science fiction",
    "Play",
    "Non-fiction",
    "Biography / autobiography",
    "Business",
    "Food"
  ] %}

  {% set regionOrder = [
    "India",
    "Asia",
    "UK",
    "Ireland",
    "Europe",
    "USA",
    "South America",
    "Australia"
  ] %}

  <div id="view-genre" class="shelf-view">
    {% for genre in genreOrder %}
      <div class="shelf-group">
        <h3 class="shelf-group__heading">{{ genre }}</h3>
        <ul class="shelf-list">
          {% for book in books %}
            {% if book.genre == genre %}
             <li class="book">
                <p class="book__title">{{ book.title }}</p>
                <p class="book__author">{{ book.author }}</p>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>

  <div id="view-region" class="shelf-view" hidden>
    {% for region in regionOrder %}
      <div class="shelf-group">
        <h3 class="shelf-group__heading">{{ region }}</h3>
        <ul class="shelf-list">
          {% for book in books %}
            {% if book.region == region %}
            <li class="book">
                <p class="book__title">{{ book.title }}</p>
                <p class="book__author">{{ book.author }}</p>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
</div>
</section>

<style>
  .bookshelf-page {
    padding: var(--space-6) 0;
  }

  .bookshelf-page h1 {
    margin: 0 0 var(--space-5);
  }

  .bookshelf-section__title {
    margin: 0 0 var(--space-3);
  }

  .current-read {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }

.current-read__cover {
    width: 200px;
    height: auto;
    border: 0.5px solid var(--border);
    border-radius: 4px;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .current-read__cover {
      width: 140px;
    }
  }

  .current-read__title {
    font-style: italic;
    font-size: 1.05em;
    margin: var(--space-1) 0 0;
  }

  .current-read__author {
    color: var(--text-muted);
    margin: var(--space-1) 0 0;
  }

  .shelf-toggle {
    display: flex;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
  }

  .shelf-toggle__btn {
    background: none;
    border: none;
    padding: 0 0 4px;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 14px;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
  }

  .shelf-toggle__btn[aria-pressed="true"] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .shelf-toggle__btn:hover {
    color: var(--accent);
  }

  .shelf-group {
    margin-bottom: var(--space-4);
  }

  .shelf-group:last-child {
    margin-bottom: 0;
  }

.shelf-group__heading {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(17px, 1vw + 12px, 20px);
    color: var(--text);
    margin: 0 0 var(--space-2);
  }

  .shelf-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

 .shelf-list li {
    margin-bottom: var(--space-3);
  }

  .book__title {
    margin: 0;
  }

  .book__author {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--text-muted);
    margin: var(--space-1) 0 0;
  }
</style>

<script>
  (function () {
    var genreBtn = document.getElementById("toggle-genre");
    var regionBtn = document.getElementById("toggle-region");
    var genreView = document.getElementById("view-genre");
    var regionView = document.getElementById("view-region");

    function show(which) {
      var isGenre = which === "genre";
      genreView.hidden = !isGenre;
      regionView.hidden = isGenre;
      genreBtn.setAttribute("aria-pressed", isGenre ? "true" : "false");
      regionBtn.setAttribute("aria-pressed", isGenre ? "false" : "true");
    }

    genreBtn.addEventListener("click", function () { show("genre"); });
    regionBtn.addEventListener("click", function () { show("region"); });
  })();
</script>
