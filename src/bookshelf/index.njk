---
title: Bookshelf
layout: base.njk
permalink: /bookshelf/
---
<h1>Bookshelf</h1>
{% if collections.bookshelf.length %}
<div class="grid">
  {% for item in collections.bookshelf %}
  <div>
    <h3>{{ item.data.title }}</h3>
    <p>{{ item.data.author }}</p>
  </div>
  {% endfor %}
</div>
{% else %}
<p>No books added yet. Entries added through the CMS will appear here.</p>
{% endif %}
