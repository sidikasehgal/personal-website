---
title: Reading list
layout: base.njk
permalink: /reading-list/
---
<h1>Reading list</h1>
{% if collections.readingList.length %}
<div class="grid">
  {% for item in collections.readingList %}
  <div>
    <h3>{{ item.data.title }}</h3>
    <p>{{ item.data.author }}</p>
  </div>
  {% endfor %}
</div>
{% else %}
<p>Nothing on the list yet. Entries added through the CMS will appear here.</p>
{% endif %}
