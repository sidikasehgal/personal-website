---
layout: base.njk
title: On UX Writing
permalink: /writing/
---

<section class="container">
<div class="prose writing-page">
  <h1>On UX Writing</h1>
  <p class="writing-page__intro">Articles, talks, and posts on UX writing.</p>

  {% macro writingSection(heading, items) %}
    {% if items and items.length %}
    <div class="writing-section">
      <h2 class="writing-section__heading">{{ heading }}</h2>
      <div class="writing-list">
        {% for item in items | sort(attribute='date', reverse=true) %}
          <div class="writing-item">
            <a class="writing-item__link" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
            <p class="writing-item__meta">{{ item.publisher }} &middot; {{ item.date | monthYear }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  {% endmacro %}

  {{ writingSection("Articles", writing.articles) }}
  {{ writingSection("Videos", writing.videos) }}
  {{ writingSection("Posts", writing.posts) }}
</div>
</section>

<style>
  .writing-page {
    padding: var(--space-6) 0;
  }

  .writing-page__intro {
    color: var(--text-muted);
    margin: 0 0 var(--space-5);
  }

  .writing-section {
    margin-bottom: var(--space-5);
  }

  .writing-section:last-child {
    margin-bottom: 0;
  }

  .writing-section__heading {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin: 0 0 var(--space-3);
  }

  .writing-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .writing-item__link {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1.5px solid var(--accent);
    padding-bottom: 1px;
  }

  .writing-item__link:hover,
  .writing-item__link:focus-visible {
    color: var(--accent);
  }

  .writing-item__meta {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--text-muted);
    margin: var(--space-1) 0 0;
  }
</style>
